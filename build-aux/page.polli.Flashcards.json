{
  "id": "page.polli.Flashcards",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "default-branch": "stable",
  "collection-id": "page.polli.Flatpaks",
  "command": "flashcards",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=xdg-documents/Flashcards:create"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/flashcards/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "modules": [
    {
      "name": "flashcards",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".flatpak-build",
            ".flatpak-builder",
            ".git",
            "build-aux/cargo-sources.json",
            "build-aux/package-flatpak.sh",
            "build-aux/page.polli.Flashcards.Devel.json",
            "build-aux/page.polli.Flashcards.flatpakref.in",
            "build-aux/page.polli.Flashcards.flatpakrepo.in",
            "build-aux/page.polli.Flashcards.json",
            "dist",
            "docs",
            "target"
          ]
        },
        "cargo-sources.json",
        {
          "type": "shell",
          "commands": [
            "mv cargo/config cargo/config.toml"
          ]
        }
      ]
    }
  ]
}
